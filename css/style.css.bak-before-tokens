       /* Toggle Switch */
       .toggle-switch {
           position: relative;
           display: inline-block;
           width: 48px;
           height: 26px;
           flex-shrink: 0;
       }

       .toggle-switch input {
           opacity: 0;
           width: 0;
           height: 0;
       }

       .toggle-slider {
           position: absolute;
           cursor: pointer;
           top: 0;
           left: 0;
           right: 0;
           bottom: 0;
           background: #ccc;
           border-radius: 26px;
           transition: 0.3s;
       }

       .toggle-slider:before {
           position: absolute;
           content: "";
           height: 20px;
           width: 20px;
           left: 3px;
           bottom: 3px;
           background: white;
           border-radius: 50%;
           transition: 0.3s;
       }

       .toggle-switch input:checked+.toggle-slider {
           background: linear-gradient(135deg, #667eea, #764ba2);
       }

       .toggle-switch input:checked+.toggle-slider:before {
           transform: translateX(22px);
       }

