  :root {
       --ar-font: 28px;
       --zh-font: 20px;
       --bg: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
       --bg-2: #f5f7fb;
       --card: rgba(255, 255, 255, 0.85);
       --card-border: rgba(255, 255, 255, 0.4);
       --text: #1a1a2e;
       --text-soft: #4a4a6a;
       --primary: #667eea;
       --primary-dark: #5568d3;
       --secondary: #764ba2;
       --accent: #f093fb;
       --success: #10b981;
       --danger: #ef4444;
       --warning: #f59e0b;
       --shadow: 0 10px 40px rgba(102, 126, 234, 0.15);
       --shadow-lg: 0 20px 60px rgba(102, 126, 234, 0.25);
       --radius: 20px;
   }

   [data-theme="dark"] {
       --bg: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
       --bg-2: #12121e;
       --card: rgba(30, 30, 50, 0.85);
       --card-border: rgba(255, 255, 255, 0.1);
       --text: #f5f5fa;
       --text-soft: #b8b8d0;
       --shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
       --shadow-lg: 0 20px 60px rgba(0, 0, 0, 0.7);
   }

   * {
       box-sizing: border-box;
       margin: 0;
       padding: 0
   }

   html {
       scroll-behavior: smooth;
       scroll-padding-top: 140px
   }

   body {
       font-family: 'Noto Sans Arabic', 'Noto Sans SC', sans-serif;
       background: var(--bg-2);
       color: var(--text);
       min-height: 100vh;
       line-height: 1.7;
       overflow-x: hidden;
       transition: background .4s, color .4s;
   }

   body::before {
       content: '';
       position: fixed;
       inset: 0;
       background: var(--bg);
       opacity: 0.12;
       z-index: -1;
       pointer-events: none;
   }

   .ar-text {
       font-size: var(--ar-font);
       font-weight: 500;
       line-height: 1.9;
       direction: rtl;
       font-family: 'Noto Sans Arabic', sans-serif
   }

   .zh-text {
       font-family: 'Noto Sans SC', sans-serif;
       font-size: var(--zh-font);
       color: var(--text-soft);
       direction: ltr;
       display: none;
       margin-top: 6px;
       opacity: 0;
       transition: opacity .3s;
       font-weight: 400;
   }

   .zh-text.show {
       display: block;
       opacity: 1
   }

   /* ================= NEW NAVIGATION SYSTEM (PHASE 1 & 2) ================= */
   .topbar {
       position: fixed;
       top: 0;
       left: 0;
       right: 0;
       height: 56px;
       background: var(--card);
       backdrop-filter: blur(20px);
       -webkit-backdrop-filter: blur(20px);
       z-index: 1000;
       border-bottom: 1px solid var(--card-border);
   }

   .topbar-inner {
       max-width: 1200px;
       margin: 0 auto;
       height: 100%;
       display: flex;
       align-items: center;
       justify-content: space-between;
       padding: 0 20px;
   }

   .brand {
       display: flex;
       align-items: center;
       gap: 10px;
   }

   .brand-logo {
       font-size: 24px;
   }

    .brand-title {
        font-family: 'Noto Sans Arabic', sans-serif;
        font-size: 18px;
        font-weight: 800;
        color: var(--primary);
        white-space: nowrap;
    }

   .current-section-title {
       font-size: 16px;
       font-weight: 700;
       color: var(--text);
       transition: opacity 0.2s ease;
       font-family: 'Noto Sans Arabic', sans-serif;
   }

   .current-section-title.fade {
       opacity: 0;
   }

   .topbar-actions {
       display: flex;
       align-items: center;
       gap: 12px;
       position: relative;
       z-index: 200;
       isolation: isolate;
       flex-shrink: 0;
       pointer-events: auto;
   }

   .settings-btn {
       width: 44px;
       height: 44px;
       display: grid;
       place-items: center;
       background: rgba(102, 126, 234, 0.1);
       border: none;
       border-radius: 12px;
       font-size: 20px;
       cursor: pointer;
       transition: all 0.2s ease;
       position: relative;
       z-index: 201;
       pointer-events: auto;
       flex-shrink: 0;
   }

   .settings-btn:hover {
       background: rgba(102, 126, 234, 0.2);
       transform: scale(1.05);
   }

   /* Stepper Container */
   .stepper-wrap {
       position: fixed;
       top: 64px;
       right: 0;
       left: auto;
       width: auto;
       display: inline-flex;
       justify-content: flex-end;
       padding-right: 20px;
       height: 52px;
       z-index: 998;
       background: var(--card);
       backdrop-filter: blur(20px);
       -webkit-backdrop-filter: blur(20px);
       border-bottom: 1px solid var(--card-border);
       align-items: center;
       box-sizing: border-box;
   }

   .stepper-desktop {
       display: flex;
       align-items: center;
       flex: unset;
       min-width: 0;
       justify-content: flex-end;
       margin-left: 12px;
       margin-right: 12px;
       pointer-events: auto;
   }

   .stepper-mobile {
       display: none;
       width: 100%;
       flex-direction: column;
       align-items: center;
   }

   .step-item {
       display: flex;
       flex-direction: column;
       align-items: center;
       gap: 0;
       padding: 4px 8px;
       cursor: pointer;
       position: relative;
       outline: none;
   }

   .step-dot {
       width: 10px;
       height: 10px;
       border-radius: 50%;
       display: flex;
       align-items: center;
       justify-content: center;
       font-size: 0;
       transition: all 0.3s ease;
       background: rgba(0, 0, 0, 0.1);
       border: 2px solid rgba(102, 126, 234, 0.3);
   }

   [data-theme="dark"] .step-dot {
       background: rgba(255, 255, 255, 0.1);
   }

   .step-item.completed .step-dot {
       background: linear-gradient(135deg, #667eea, #764ba2);
       border-color: transparent;
       width: 14px;
       height: 14px;
       font-size: 8px;
       color: #fff;
   }

   .step-item.current .step-dot {
       background: linear-gradient(135deg, #667eea, #764ba2);
       border-color: transparent;
       width: 14px;
       height: 14px;
       font-size: 8px;
       color: #fff;
       box-shadow: 0 0 12px rgba(102, 126, 234, 0.6);
       transform: scale(1.15);
   }

   .step-item.upcoming {
       opacity: 0.4;
       pointer-events: none;
   }

   .step-name {
       font-size: 10px;
       font-weight: 500;
       margin-top: 2px;
       white-space: nowrap;
       transition: all 0.3s ease;
   }

   .step-item.current .step-name {
       font-weight: 700;
       color: var(--primary);
   }

   .step-line {
       flex: 1;
       height: 2px;
       background: rgba(102, 126, 234, 0.2);
       margin: 0 10px;
       transform: translateY(-8px);
       pointer-events: none;
   }

   .step-line.completed {
       background: linear-gradient(90deg, #667eea, #764ba2);
   }

   /* Mid-size Screens Adaptivity */
   @media (min-width: 900px) and (max-width: 1280px) {
       .step-item .step-name {
           display: none;
       }

       .step-item:hover .step-name {
           display: block;
           position: absolute;
           background: var(--card);
           border: 1px solid var(--card-border);
           padding: 4px 10px;
           border-radius: 6px;
           bottom: -30px;
           z-index: 1001;
       }
   }

   /* Mobile Stepper Elements Redesign */
   .stepper-mobile-main {
       display: flex;
       align-items: center;
       justify-content: space-between;
       width: 100%;
   }

   .mobile-stage-info {
       display: flex;
       align-items: center;
       gap: 6px;
       flex: 1;
       justify-content: center;
   }

   .mobile-stage-icon {
       font-size: 18px;
   }

   .mobile-stage-name {
       font-size: 15px;
       font-weight: 700;
       color: var(--primary);
   }

   .step-arrow {
       width: 36px;
       height: 36px;
       border-radius: 50%;
       border: none;
       background: rgba(102, 126, 234, 0.1);
       color: var(--primary);
       font-size: 18px;
       cursor: pointer;
       display: grid;
       place-items: center;
       transition: all 0.2s;
   }

   .step-arrow:disabled {
       opacity: 0.3;
   }

   .mobile-stage-dots {
       display: flex;
       justify-content: center;
       gap: 6px;
       margin-top: 4px;
   }

   .mobile-dot {
       width: 6px;
       height: 6px;
       border-radius: 50%;
       background: rgba(102, 126, 234, 0.2);
       cursor: pointer;
       transition: all 0.2s;
   }

   .mobile-dot.current {
       background: var(--primary);
       width: 8px;
       height: 8px;
   }

   .progress-wrap {
        position: fixed;
        top: 56px;
        left: 0;
        right: 0;
        height: 4px;
        background: rgba(102, 126, 234, 0.1);
        z-index: 999;
    }

    .progress-bar {
        position: absolute;
        top: 0;
        right: 0;
        height: 100%;
        background: linear-gradient(-90deg, #667eea, #764ba2);
        width: 0%;
        transition: width .1s linear;
    }

   main {
       max-width: 1200px;
       margin: 0 auto;
       padding: 80px 20px 80px;
   }

   @media(max-width:900px) {
       .stepper-desktop {
           display: none;
       }

       .stepper-mobile {
           display: flex;
       }

       .stepper-wrap {
           height: 48px;
       }

       .progress-wrap {
           top: 56px !important;
       }

       main {
           padding-top: 135px;
       }

       .brand-title-prefix {
           display: none;
       }
   }

   .section {
       margin-bottom: 60px;
       animation: fadeInUp .6s ease-out;
   }

   @keyframes fadeInUp {
       from {
           opacity: 0;
           transform: translateY(30px)
       }

       to {
           opacity: 1;
           transform: translateY(0)
       }
   }

   .section-header {
       display: flex;
       align-items: center;
       gap: 16px;
       margin-bottom: 24px;
       padding: 20px 24px;
       background: var(--card);
       backdrop-filter: blur(16px);
       border: 1px solid var(--card-border);
       border-radius: var(--radius);
       box-shadow: var(--shadow);
   }

   .section-icon {
       width: 56px;
       height: 56px;
       border-radius: 16px;
       display: grid;
       place-items: center;
       font-size: 26px;
       background: linear-gradient(135deg, #667eea, #764ba2);
       box-shadow: 0 6px 20px rgba(102, 126, 234, .3);
       flex-shrink: 0;
   }

   .section-title {
       font-size: 26px;
       font-weight: 800;
       font-family: 'Noto Sans Arabic', sans-serif
   }

   .section-subtitle {
       font-size: 16px;
       color: var(--text-soft);
       margin-top: 4px;
       font-family: 'Noto Sans SC', sans-serif
   }

   .card {
       background: var(--card);
       backdrop-filter: blur(16px);
       -webkit-backdrop-filter: blur(16px);
       border: 1px solid var(--card-border);
       border-radius: var(--radius);
       padding: 28px;
       box-shadow: var(--shadow);
       transition: all .3s;
   }

   .card:hover {
       box-shadow: var(--shadow-lg)
   }

   /* ========== HOOK ========== */
   .hero {
       position: relative;
       padding: 50px 30px;
       text-align: center;
       border-radius: 28px;
       background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
       color: #fff;
       overflow: hidden;
       box-shadow: var(--shadow-lg);
   }

   .hero::before {
       content: '';
       position: absolute;
       inset: 0;
       background: radial-gradient(circle at 20% 50%, rgba(255, 255, 255, .2) 0%, transparent 50%),
           radial-gradient(circle at 80% 30%, rgba(255, 255, 255, .15) 0%, transparent 50%);
   }

   .hero-emojis {
       font-size: 60px;
       margin-bottom: 16px;
       letter-spacing: 10px;
       animation: bounce 2.5s ease-in-out infinite;
   }

   @keyframes bounce {

       0%,
       100% {
           transform: translateY(0)
       }

       50% {
           transform: translateY(-10px)
       }
   }

   .hero h1 {
       font-size: 48px;
       margin-bottom: 14px;
       font-weight: 800;
       position: relative;
       z-index: 1;
       font-family: 'Noto Sans Arabic', sans-serif
   }

   .hero-sub {
       font-size: 22px;
       opacity: .95;
       position: relative;
       z-index: 1;
       font-family: 'Noto Sans SC', sans-serif;
       margin-top: 8px
   }

   .hero-tagline {
       display: inline-block;
       margin-top: 20px;
       padding: 12px 28px;
       background: rgba(255, 255, 255, .2);
       backdrop-filter: blur(10px);
       border-radius: 40px;
       font-size: 16px;
       font-weight: 600;
       border: 1px solid rgba(255, 255, 255, .3);
       position: relative;
       z-index: 1;
       font-family: 'Noto Sans Arabic', 'Noto Sans SC', sans-serif;
   }

   .compare-grid {
       display: grid;
       grid-template-columns: 1fr 1fr;
       gap: 20px;
       margin-top: 30px;
   }

   @media(max-width:700px) {
       .compare-grid {
           grid-template-columns: 1fr
       }
   }

   .compare-card {
       padding: 30px 24px;
       border-radius: 20px;
       transition: transform .3s;
       text-align: center;
   }

   .compare-card:hover {
       transform: translateY(-6px)
   }

   .compare-card:nth-child(1) {
       background: linear-gradient(135deg, #ffecd2, #fcb69f);
       color: #5d2e0a
   }

   .compare-card:nth-child(2) {
       background: linear-gradient(135deg, #a1c4fd, #c2e9fb);
       color: #0a3d5d
   }

   .compare-emoji {
       font-size: 70px;
       margin-bottom: 12px;
       display: block
   }

   .compare-title {
       font-size: 32px;
       font-weight: 800;
       margin-bottom: 8px;
       font-family: 'Noto Sans Arabic', sans-serif
   }

   .compare-zh {
       font-size: 20px;
       opacity: .85;
       font-family: 'Noto Sans SC', sans-serif
   }

   /* Thinking Questions */
   .q-grid {
       display: grid;
       grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
       gap: 16px;
       margin-top: 20px
   }

   .q-card {
       padding: 24px;
       background: linear-gradient(135deg, rgba(102, 126, 234, .08), rgba(240, 147, 251, .08));
       border: 2px solid transparent;
       border-radius: 18px;
       cursor: pointer;
       transition: all .3s;
       position: relative;
   }

   .q-card:hover {
       border-color: var(--primary);
       transform: translateY(-4px);
       box-shadow: var(--shadow)
   }

   .q-number {
       position: absolute;
       top: -12px;
       right: 20px;
       width: 36px;
       height: 36px;
       border-radius: 50%;
       background: linear-gradient(135deg, #667eea, #764ba2);
       color: #fff;
       display: grid;
       place-items: center;
       font-weight: 800;
       box-shadow: 0 4px 10px rgba(102, 126, 234, .4);
       font-family: 'Noto Sans Arabic', sans-serif;
       font-size: 16px;
   }

   .q-emoji {
       font-size: 40px;
       margin-bottom: 10px;
       display: block
   }

   /* Dialogue */
   .scene-img+.scene-img {
       margin-top: 16px;
   }

   .dialogue-container {
       display: grid;
       grid-template-columns: 1fr 1fr;
       gap: 30px;
       align-items: start;
   }

   @media(max-width:900px) {
       .dialogue-container {
           grid-template-columns: 1fr
       }
   }

   .scene-img {
       border-radius: 20px;
       overflow: hidden;
       box-shadow: var(--shadow-lg);
       background: linear-gradient(135deg, #667eea, #764ba2);
       aspect-ratio: 4/3;
       display: grid;
       place-items: center;
       font-size: 100px;
       color: #fff;
       position: relative;
   }

   .scene-img .scene-label {
       position: absolute;
       bottom: 16px;
       left: 16px;
       right: 16px;
       background: rgba(0, 0, 0, .5);
       backdrop-filter: blur(10px);
       padding: 12px 18px;
       border-radius: 12px;
       font-size: 16px;
       font-weight: 600;
       text-align: center;
       font-family: 'Noto Sans Arabic', 'Noto Sans SC', sans-serif;
   }

   .dialogue-box {
       display: flex;
       flex-direction: column;
       gap: 14px;
   }

   .dial-line {
       padding: 18px 22px;
       border-radius: 18px;
       cursor: pointer;
       transition: all .3s;
       border: 2px solid transparent;
       position: relative;
       opacity: .85;
   }

   .dial-line.revealed {
       opacity: 1
   }

   .dial-line:hover {
       transform: translateX(-6px);
       box-shadow: var(--shadow)
   }

   .dial-line.highlighted {
       border-color: var(--primary);
       box-shadow: 0 0 0 4px rgba(102, 126, 234, .2)
   }


   .dial-line:nth-child(odd) {
       background: linear-gradient(135deg, rgba(102, 126, 234, .1), rgba(102, 126, 234, .2));
       border-right: 4px solid var(--primary)
   }

   .dial-line:nth-child(even) {
       background: linear-gradient(135deg, rgba(240, 147, 251, .1), rgba(240, 147, 251, .2));
       border-right: 4px solid var(--accent)
   }

   .dial-line:nth-child(odd) .speaker {
       background: var(--primary);
       color: #fff
   }

   .dial-line:nth-child(even) .speaker {
       background: var(--accent);
       color: #fff
   }

   .speaker {
       display: inline-block;
       font-weight: 700;
       font-size: 15px;
       padding: 4px 12px;
       border-radius: 8px;
       margin-bottom: 6px;
       font-family: 'Noto Sans Arabic', sans-serif;
   }

   .reveal-btns {
       display: flex;
       gap: 10px;
       margin-top: 16px;
       flex-wrap: wrap
   }

   .btn {
       padding: 12px 22px;
       border-radius: 12px;
       border: none;
       cursor: pointer;
       font-weight: 600;
       font-size: 15px;
       transition: all .25s;
       font-family: 'Noto Sans Arabic', 'Noto Sans SC', sans-serif;
   }

   .btn-primary {
       background: linear-gradient(135deg, #667eea, #764ba2);
       color: #fff;
       box-shadow: 0 4px 14px rgba(102, 126, 234, .4)
   }

   .btn-primary:hover {
       transform: translateY(-2px);
       box-shadow: 0 6px 18px rgba(102, 126, 234, .5)
   }

   .btn-ghost {
       background: rgba(102, 126, 234, .1);
       color: var(--primary)
   }

   .btn-ghost:hover {
       background: var(--primary);
       color: #fff
   }

   /* Focus Mode */
   body.focus-mode .topbar {
       opacity: .3;
       transition: opacity .3s
   }

   body.focus-mode .topbar:hover {
       opacity: 1
   }

   body.focus-mode .section:not(.focused) {
       opacity: .2;
       filter: blur(2px);
       transition: all .4s
   }

   /* Explanation */
   .explain-block {
       padding: 22px;
       margin-bottom: 16px;
       border-radius: 16px;
       background: linear-gradient(135deg, rgba(102, 126, 234, .06), rgba(240, 147, 251, .06));
       border-right: 4px solid var(--primary);
       transition: all .3s;
   }

   .explain-block:hover {
       transform: translateX(-4px);
       box-shadow: var(--shadow)
   }

   .explain-label {
       display: inline-block;
       padding: 6px 14px;
       background: var(--primary);
       color: #fff;
       border-radius: 8px;
       font-size: 14px;
       font-weight: 700;
       margin-bottom: 12px;
       font-family: 'Noto Sans Arabic', 'Noto Sans SC', sans-serif;
   }

   .explain-note {
       margin-top: 12px;
       padding: 14px 18px;
       background: rgba(245, 158, 11, .1);
       border-right: 3px solid var(--warning);
       border-radius: 10px;
       font-family: 'Noto Sans Arabic', 'Noto Sans SC', sans-serif;
   }

   /* Vocab */
   .vocab-grid {
       display: grid;
       grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
       gap: 18px
   }

   .vocab-card {
       background: linear-gradient(135deg, #fff, #f5f7fb);
       border-radius: 18px;
       padding: 22px 16px;
       text-align: center;
       cursor: pointer;
       transition: all .4s;
       border: 2px solid transparent;
       position: relative;
       overflow: visible;
       min-height: 190px;
       display: flex;
       flex-direction: column;
       justify-content: center;
       align-items: center;
   }

   [data-theme="dark"] .vocab-card {
       background: linear-gradient(135deg, #1e1e32, #2a2a40)
   }

   .vocab-card:hover {
       transform: translateY(-8px) scale(1.03);
       border-color: var(--primary);
       box-shadow: var(--shadow-lg)
   }

   .vocab-card.flipped {
       background: linear-gradient(135deg, #667eea, #764ba2);
       color: #fff
   }

   .vocab-emoji {
       font-size: 46px;
       margin-bottom: 10px
   }

   .vocab-ar {
       font-size: 24px;
       font-weight: 700;
       margin-bottom: 6px;
       direction: rtl;
       font-family: 'Noto Sans Arabic', sans-serif
   }

   .vocab-zh-hidden {
       font-size: 16px;
       opacity: 0;
       height: 0;
       font-family: 'Noto Sans SC', sans-serif;
       transition: all .3s;
   }

   .vocab-card.flipped .vocab-zh-hidden,
   .vocab-card.revealed .vocab-zh-hidden {
       opacity: 1;
       height: auto;
       margin-top: 8px
   }

   .vocab-tag {
       position: absolute;
       top: 8px;
       left: 8px;
       font-size: 12px;
       padding: 3px 10px;
       border-radius: 8px;
       background: rgba(102, 126, 234, .15);
       color: var(--primary);
       font-weight: 600;
       font-family: 'Noto Sans Arabic', 'Noto Sans SC', sans-serif;
   }

    /* Grammar — Premium 3D Arabic Typography */
    .formula-box {
        padding: 28px;
        border-radius: 24px;
        background: linear-gradient(145deg, #7c5cbf, #5b3a8c);
        color: #fff;
        text-align: center;
        box-shadow:
            0 8px 40px rgba(100, 50, 200, .3),
            0 0 60px rgba(120, 80, 200, .12);
        margin-bottom: 20px;
