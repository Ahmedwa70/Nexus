   /* ============================================== */
   /*  ✨ SPLASH SCREEN - شاشة التحميل الافتتاحية   */
   /* ============================================== */

   .splash-screen {
       position: fixed;
       inset: 0;
       z-index: 9999999;
       background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
       display: flex;
       align-items: center;
       justify-content: center;
       opacity: 1;
       visibility: visible;
       transition: opacity 0.6s ease, visibility 0.6s ease;
       overflow: hidden;
   }

   .splash-screen::before {
       content: '';
       position: absolute;
       inset: 0;
       background-image:
           radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.15) 0%, transparent 40%),
           radial-gradient(circle at 80% 70%, rgba(255, 255, 255, 0.12) 0%, transparent 40%),
           radial-gradient(circle at 50% 50%, rgba(240, 147, 251, 0.2) 0%, transparent 60%);
       animation: splashBgMove 8s ease-in-out infinite;
   }

   @keyframes splashBgMove {

       0%,
       100% {
           transform: scale(1) rotate(0deg);
       }

       50% {
           transform: scale(1.1) rotate(3deg);
       }
   }

   .splash-screen.fade-out {
       opacity: 0;
       visibility: hidden;
       pointer-events: none;
   }

   .splash-content {
       position: relative;
       text-align: center;
       color: #fff;
       animation: splashFadeIn 0.8s ease-out;
   }

   @keyframes splashFadeIn {
       from {
           opacity: 0;
           transform: translateY(20px) scale(0.95);
       }

       to {
           opacity: 1;
           transform: translateY(0) scale(1);
       }
   }

   .splash-icon {
       font-size: 110px;
       line-height: 1;
       margin-bottom: 24px;
       display: inline-block;
       filter: drop-shadow(0 10px 30px rgba(0, 0, 0, 0.25));
       animation: splashIconBounce 2s ease-in-out infinite;
   }

   @keyframes splashIconBounce {

       0%,
       100% {
           transform: translateY(0) scale(1);
       }

       50% {
           transform: translateY(-12px) scale(1.05);
       }
   }

   .splash-title {
       font-family: 'Noto Sans Arabic', sans-serif;
       font-size: 32px;
       font-weight: 800;
