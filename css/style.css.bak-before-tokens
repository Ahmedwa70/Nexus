   /* ============================================== */
   /*  ✨ AUTO FOCUS - وضع التركيز التلقائي           */
   /*  نظام Overlay: شريط أفقي مرئي في وسط الشاشة     */
   /*  وكل ما هو فوق وتحته يضبَّب                     */
   /* ============================================== */

   /* الـ overlay الأساسي: مكوّن من قناعين (أعلى وأسفل) */
   .auto-focus-overlay {
       position: fixed;
       inset: 0;
       pointer-events: none;
       z-index: 9000;
       /* مخفي افتراضياً */
       opacity: 0;
       visibility: hidden;
       transition: opacity 0.7s ease, visibility 0.7s ease;
   }

   body.auto-focus-active .auto-focus-overlay {
       opacity: 1;
       visibility: visible;
   }

   /* القناع العلوي والسفلي */
   .afo-mask {
       position: absolute;
       left: 0;
       right: 0;
       background: rgba(255, 255, 255, 0.55);
       backdrop-filter: blur(4px) saturate(0.7);
       -webkit-backdrop-filter: blur(4px) saturate(0.7);
       transition: background 0.4s ease;
   }

   .afo-mask-top {
       top: 0;
       /* يُحدَّد ارتفاعه من JS */
       /* تأثير fade من الحافة العلوية إلى نافذة القراءة */
       mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 60%, rgba(0, 0, 0, 0.5) 100%);
       -webkit-mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 1) 60%, rgba(0, 0, 0, 0.5) 100%);
   }

   .afo-mask-bottom {
       /* top يُحدَّد من JS */
       bottom: 0;
       mask-image: linear-gradient(to top, rgba(0, 0, 0, 1) 60%, rgba(0, 0, 0, 0.5) 100%);
       -webkit-mask-image: linear-gradient(to top, rgba(0, 0, 0, 1) 60%, rgba(0, 0, 0, 0.5) 100%);
   }

   /* الوضع الليلي: قناع داكن بدلاً من فاتح */
   [data-theme="dark"] .afo-mask {
       background: rgba(15, 12, 41, 0.65);
   }

