       font-size: 11px;
       opacity: 0.8;
       margin-top: 2px;
   }

   /* الوضع الليلي للإشعار العائم */
   [data-theme="dark"] .auto-focus-indicator {
       background: linear-gradient(135deg, rgba(48, 43, 99, 0.95), rgba(36, 36, 62, 0.95));
       box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5),
           0 0 0 1px rgba(255, 255, 255, 0.1) inset;
   }

   [data-theme="dark"] .auto-focus-toast {
       background: rgba(245, 245, 250, 0.95);
       color: #1a1a2e;
   }

   /* الموبايل */
   @media (max-width: 600px) {

       .auto-focus-indicator,
       .auto-focus-toast {
           padding: 10px 16px;
           gap: 10px;
       }

       .auto-focus-indicator {
           bottom: 16px;
       }

       .auto-focus-toast {
           top: 80px;
       }

       .auto-focus-indicator .afi-icon,
       .auto-focus-toast .aft-icon {
           font-size: 18px;
       }

       .auto-focus-indicator .afi-ar,
       .auto-focus-toast .aft-ar {
           font-size: 12px;
       }

       .auto-focus-indicator .afi-zh,
       .auto-focus-toast .aft-zh {
           font-size: 10px;
       }
   }

   /* احترام تفضيل المستخدم بتقليل الحركة */
   @media (prefers-reduced-motion: reduce) {

       .auto-focus-overlay,
       .auto-focus-indicator,
       .auto-focus-toast,
       .auto-focus-indicator .afi-icon,
       .ds-btn.af-btn.active::after {
           transition: opacity 0.3s ease !important;
           animation: none !important;
       }

       .afo-mask {
           backdrop-filter: blur(2px) !important;
           -webkit-backdrop-filter: blur(2px) !important;
       }
   }

   /* ============================================== */
   /*  🎓 TEACHER TOOLS - أدوات المعلم (تصميم عصري)  */
   /* ============================================== */

   /* === زر المعلم في الـ topbar === */
   .ds-btn.tt-topbar-btn {
       position: relative;
       transition: all 0.3s ease;
   }

   .ds-btn.tt-topbar-btn:hover {
       background: linear-gradient(135deg, rgba(102, 126, 234, 0.15), rgba(240, 147, 251, 0.15));
       color: var(--primary);
   }

   .ds-btn.tt-topbar-btn.panel-open {
       background: linear-gradient(135deg, #667eea, #764ba2);
       color: #fff;
       box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
   }

   /* === شارة "الإجابات مخفية" في الـ topbar === */
   .answers-hidden-badge {
       position: absolute;
       top: -6px;
       left: -6px;
       width: 20px;
       height: 20px;
       background: linear-gradient(135deg, #f59e0b, #f97316);
       color: #fff;
       border-radius: 50%;
       font-size: 11px;
       display: flex;
       align-items: center;
       justify-content: center;
       box-shadow: 0 2px 8px rgba(245, 158, 11, 0.5),
           0 0 0 2px var(--bg, #fff);
       opacity: 0;
       visibility: hidden;
       transform: scale(0);
       transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
       pointer-events: none;
       z-index: 5;
   }

   .answers-hidden-badge.show {
       opacity: 1;
       visibility: visible;
       transform: scale(1);
       animation: badgeBreathe 2.5s ease-in-out infinite;
   }

   @keyframes badgeBreathe {

       0%,
       100% {
           box-shadow: 0 2px 8px rgba(245, 158, 11, 0.5),
               0 0 0 2px var(--bg, #fff),
               0 0 0 0 rgba(245, 158, 11, 0.4);
       }

       50% {
           box-shadow: 0 2px 8px rgba(245, 158, 11, 0.5),
               0 0 0 2px var(--bg, #fff),
               0 0 0 6px rgba(245, 158, 11, 0);
       }
   }

   [data-theme="dark"] .answers-hidden-badge {
       box-shadow: 0 2px 8px rgba(245, 158, 11, 0.5),
           0 0 0 2px #1a1a2e;
   }

   /* === لوحة أدوات المعلم === */
   .teacher-toolbar {
       position: fixed;
       top: 75px;
       left: 24px;
       z-index: 99998;
       font-family: 'Noto Sans Arabic', 'Noto Sans SC', sans-serif;
       direction: rtl;
       pointer-events: none;
   }

   .teacher-toolbar .tt-panel {
       pointer-events: auto;
   }

   /* اللوحة - تصميم عصري كومباكت */
   .tt-panel {
       width: 230px;
       background: rgba(255, 255, 255, 0.85);
       backdrop-filter: blur(24px) saturate(180%);
       -webkit-backdrop-filter: blur(24px) saturate(180%);
       border-radius: 20px;
       box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15),
           0 0 0 1px rgba(255, 255, 255, 0.6) inset,
           0 1px 0 rgba(255, 255, 255, 0.8) inset;
       padding: 14px;
       transform: translateX(20px) scale(0.95);
       opacity: 0;
       visibility: hidden;
       transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
           opacity 0.25s ease, visibility 0.35s;
   }

   .teacher-toolbar.open .tt-panel {
       transform: translateX(0) scale(1);
       opacity: 1;
       visibility: visible;
   }

   /* الترويسة */
   .tt-header {
       display: flex;
       align-items: center;
       gap: 10px;
       padding-bottom: 12px;
       border-bottom: 1px solid rgba(102, 126, 234, 0.1);
       margin-bottom: 12px;
       position: relative;
   }

   .tt-header-icon {
       width: 36px;
       height: 36px;
       border-radius: 10px;
       background: linear-gradient(135deg, #667eea, #764ba2);
       display: flex;
       align-items: center;
       justify-content: center;
       font-size: 18px;
       box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
   }

   .tt-header-text {
       flex: 1;
       display: flex;
       flex-direction: column;
   }

   .tt-title {
       font-size: 14px;
       font-weight: 800;
       color: var(--text);
       line-height: 1.2;
   }

   .tt-zh {
       font-size: 10px;
       color: var(--text-soft);
       margin-top: 1px;
   }

   .tt-close-btn {
       width: 26px;
       height: 26px;
       border-radius: 8px;
       border: none;
       background: rgba(0, 0, 0, 0.05);
       color: var(--text-soft);
       cursor: pointer;
       font-size: 12px;
       transition: all 0.2s;
       display: flex;
       align-items: center;
       justify-content: center;
   }

   .tt-close-btn:hover {
       background: var(--danger, #ef4444);
       color: #fff;
       transform: rotate(90deg);
   }

   /* صف الأزرار السريعة (4 أزرار) */
   .tt-quick-row {
       display: grid;
       grid-template-columns: repeat(4, 1fr);
       gap: 6px;
       margin-bottom: 12px;
   }

   .tt-quick-btn {
       aspect-ratio: 1;
       border: none;
       background: linear-gradient(135deg, rgba(102, 126, 234, 0.08), rgba(240, 147, 251, 0.05));
       border-radius: 12px;
       cursor: pointer;
       font-size: 22px;
       transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
       position: relative;
       display: flex;
       align-items: center;
       justify-content: center;
       box-shadow: 0 1px 0 rgba(255, 255, 255, 0.5) inset;
   }

   .tt-quick-btn:hover {
       background: linear-gradient(135deg, #667eea, #764ba2);
       transform: translateY(-2px);
       box-shadow: 0 6px 14px rgba(102, 126, 234, 0.35);
   }

   .tt-quick-btn:hover .tt-q-ic {
       filter: brightness(1.4) drop-shadow(0 0 4px rgba(255, 255, 255, 0.5));
   }

   .tt-quick-btn.active {
       background: linear-gradient(135deg, #f093fb, #f5576c);
       box-shadow: 0 4px 12px rgba(240, 147, 251, 0.4);
   }

   /* تلميح أعلى الزر */
   .tt-quick-btn::after {
       content: attr(data-tip);
       position: absolute;
       bottom: calc(100% + 6px);
       left: 50%;
       transform: translateX(-50%) translateY(4px);
       background: rgba(26, 26, 46, 0.95);
       color: #fff;
       font-size: 10px;
       padding: 4px 8px;
       border-radius: 6px;
       white-space: nowrap;
       pointer-events: none;
       opacity: 0;
       transition: opacity 0.2s, transform 0.2s;
       font-family: 'Noto Sans Arabic', 'Noto Sans SC', sans-serif;
       direction: rtl;
   }

   .tt-quick-btn:hover::after {
       opacity: 1;
       transform: translateX(-50%) translateY(0);
   }

   /* كتلة العداد */
   .tt-timer-block {
       background: linear-gradient(135deg, rgba(102, 126, 234, 0.06), rgba(240, 147, 251, 0.04));
       border-radius: 12px;
       padding: 10px;
       margin-bottom: 10px;
       box-shadow: 0 1px 0 rgba(255, 255, 255, 0.5) inset;
   }

   .tt-timer-display {
       text-align: center;
       font-size: 28px;
       font-weight: 800;
       color: var(--primary);
       font-family: 'Noto Sans Arabic', sans-serif;
       letter-spacing: 1px;
       line-height: 1.1;
       margin-bottom: 8px;
       transition: color 0.3s;
   }

   .tt-timer-display.running {
       animation: ttTimerPulse 1s ease-in-out infinite;
   }

   .tt-timer-display.warning {
       color: var(--danger, #ef4444);
       animation: ttTimerWarn 0.5s ease-in-out infinite;
   }

   .tt-timer-display.finished {
       color: var(--success, #10b981);
       font-size: 32px;
       animation: ttTimerDone 0.5s ease;
   }

   @keyframes ttTimerPulse {

       0%,
       100% {
           opacity: 1;
       }

       50% {
           opacity: 0.65;
       }
   }

   @keyframes ttTimerWarn {

       0%,
       100% {
           transform: scale(1);
       }

       50% {
           transform: scale(1.1);
       }
   }

   @keyframes ttTimerDone {
       0% {
           transform: scale(0.5);
       }

       50% {
           transform: scale(1.2);
       }

       100% {
           transform: scale(1);
       }
   }

   .tt-timer-row {
       display: grid;
       grid-template-columns: repeat(3, 1fr) auto;
       gap: 4px;
   }

   .tt-time-btn {
       padding: 6px 0;
       border: none;
       background: rgba(255, 255, 255, 0.7);
       border-radius: 8px;
       cursor: pointer;
       font-family: 'Noto Sans Arabic', sans-serif;
       font-size: 12px;
       font-weight: 700;
       color: var(--text);
       transition: all 0.2s;
   }

   .tt-time-btn:hover {
       background: var(--primary, #667eea);
       color: #fff;
       transform: translateY(-1px);
   }

   .tt-time-btn.tt-stop {
       background: rgba(239, 68, 68, 0.1);
       color: var(--danger, #ef4444);
       width: 32px;
       font-size: 11px;
   }

   .tt-time-btn.tt-stop:hover {
       background: var(--danger, #ef4444);
       color: #fff;
   }

   /* الزر العريض (طالب عشوائي) */
   .tt-wide-btn {
       width: 100%;
       display: flex;
       align-items: center;
       gap: 10px;
       padding: 10px 12px;
       border: none;
       background: linear-gradient(135deg, rgba(16, 185, 129, 0.08), rgba(102, 126, 234, 0.06));
       border-radius: 12px;
       cursor: pointer;
       font-family: inherit;
       text-align: right;
       transition: all 0.25s;
       box-shadow: 0 1px 0 rgba(255, 255, 255, 0.5) inset;
   }

   .tt-wide-btn:hover {
       background: linear-gradient(135deg, #10b981, #667eea);
       transform: translateY(-1px);
       box-shadow: 0 6px 14px rgba(16, 185, 129, 0.3);
       color: #fff;
   }

   .tt-w-ic {
       font-size: 22px;
       line-height: 1;
       flex-shrink: 0;
   }

   .tt-w-lbl {
       flex: 1;
       font-size: 13px;
       font-weight: 700;
       line-height: 1.2;
       color: var(--text);
       transition: color 0.25s;
   }

   .tt-wide-btn:hover .tt-w-lbl {
       color: #fff;
   }

   .tt-w-lbl small {
       display: block;
       font-size: 10px;
       color: var(--text-soft);
       font-weight: 500;
       margin-top: 1px;
       transition: color 0.25s;
   }

   .tt-wide-btn:hover .tt-w-lbl small {
       color: rgba(255, 255, 255, 0.85);
   }

   /* === الوضع الليلي === */
   [data-theme="dark"] .tt-panel {
       background: rgba(30, 30, 50, 0.85);
       box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5),
           0 0 0 1px rgba(255, 255, 255, 0.08) inset;
   }

   [data-theme="dark"] .tt-quick-btn {
       background: linear-gradient(135deg, rgba(102, 126, 234, 0.12), rgba(240, 147, 251, 0.08));
   }

   [data-theme="dark"] .tt-time-btn {
       background: rgba(255, 255, 255, 0.05);
       color: #e8e8f5;
   }

   [data-theme="dark"] .tt-timer-block {
       background: linear-gradient(135deg, rgba(102, 126, 234, 0.1), rgba(240, 147, 251, 0.06));
   }

   [data-theme="dark"] .tt-close-btn {
       background: rgba(255, 255, 255, 0.06);
       color: #b0b0c8;
   }

   /* ============================================== */
   /*  📺 PRESENTER MODE - وضع العرض                 */
   /* ============================================== */
   body.presenter-mode .ar-text {
       font-size: 36px !important;
       line-height: 2;
   }

   body.presenter-mode .section-title {
       font-size: 32px !important;
   }

   body.presenter-mode .vocab-card .ar-text,
   body.presenter-mode .compare-card .ar-text {
       font-size: 42px !important;
   }

   body.presenter-mode .dial-line .ar-text {
       font-size: 32px !important;
   }

   body.presenter-mode .topbar {
       opacity: 0.4;
   }

   body.presenter-mode .topbar:hover {
       opacity: 1;
   }

   /* ============================================== */
   /*  🙈 ANSWERS HIDDEN - إخفاء الإجابات             */
   /*  (بدون الدائرة الكبيرة — الشارة في الـ topbar)  */
   /* ============================================== */
   body.answers-hidden .mcq-opt,
   body.answers-hidden .tf-btn,
   body.answers-hidden .match-item {
       pointer-events: none;
   }

   body.answers-hidden .feedback,
   body.answers-hidden .smart-hint {
       display: none !important;
   }

   body.answers-hidden .mcq-opt.correct,
   body.answers-hidden .mcq-opt.wrong,
   body.answers-hidden .tf-btn.correct,
   body.answers-hidden .tf-btn.wrong,
   body.answers-hidden .fill-input.correct,
   body.answers-hidden .fill-input.wrong {
       background: inherit !important;
       color: inherit !important;
       border-color: inherit !important;
   }

   /* ============================================== */
   /*  💬 Toast لأدوات المعلم                         */
   /* ============================================== */
   .teacher-toast {
       position: fixed;
       top: 90px;
       left: 50%;
       transform: translateX(-50%) translateY(-20px);
       z-index: 99999;
       background: linear-gradient(135deg, #667eea, #764ba2);
       color: #fff;
       padding: 12px 24px;
       border-radius: 14px;
       box-shadow: 0 10px 40px rgba(102, 126, 234, 0.4);
       opacity: 0;
       visibility: hidden;
       transition: all 0.3s ease;
       font-family: 'Noto Sans Arabic', 'Noto Sans SC', sans-serif;
       direction: rtl;
       text-align: center;
   }

   .teacher-toast.show {
       opacity: 1;
       visibility: visible;
       transform: translateX(-50%) translateY(0);
   }

   .teacher-toast .tch-ar {
       font-size: 15px;
       font-weight: 700;
   }

   .teacher-toast .tch-zh {
       font-size: 11px;
       opacity: 0.85;
       margin-top: 2px;
   }

   /* ============================================== */
   /*  🃏 Modals (Flashcards / Whiteboard / Random)  */
   /* ============================================== */
   .tt-modal {
       display: none;
       position: fixed;
       inset: 0;
       z-index: 9999998;
       background: rgba(0, 0, 0, 0.6);
       backdrop-filter: blur(6px);
       -webkit-backdrop-filter: blur(6px);
       align-items: center;
       justify-content: center;
       padding: 20px;
       animation: ttModalFade 0.3s ease;
   }

   .tt-modal.show {
       display: flex;
   }

   @keyframes ttModalFade {
       from {
           opacity: 0;
       }

       to {
           opacity: 1;
       }
   }

   .tt-modal-card {
       background: var(--card);
       border-radius: 24px;
       padding: 30px;
       box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4);
       position: relative;
       max-width: 90vw;
       max-height: 90vh;
       overflow: auto;
       backdrop-filter: blur(20px);
       -webkit-backdrop-filter: blur(20px);
       animation: ttModalSlide 0.4s ease;
   }

   @keyframes ttModalSlide {
       from {
           transform: translateY(30px) scale(0.95);
           opacity: 0;
       }

       to {
           transform: translateY(0) scale(1);
           opacity: 1;
       }
   }

   .tt-modal-close {
       position: absolute;
       top: 12px;
       left: 12px;
       width: 36px;
       height: 36px;
       border-radius: 50%;
       border: none;
       background: rgba(0, 0, 0, 0.06);
       color: var(--text);
       font-size: 16px;
       cursor: pointer;
       transition: all 0.2s;
   }

   .tt-modal-close:hover {
       background: var(--danger);
       color: #fff;
       transform: rotate(90deg);
   }

   /* ====== Flashcards ====== */
   .flashcards-card {
       width: 480px;
       text-align: center;
   }

   .fc-progress {
       color: var(--text-soft);
       font-size: 14px;
       margin-bottom: 20px;
       font-family: 'Noto Sans Arabic', sans-serif;
   }

   .flashcard {
       width: 100%;
       height: 280px;
       perspective: 1200px;
       cursor: pointer;
       margin-bottom: 24px;
       position: relative;
   }

   .flashcard .fc-front,
   .flashcard .fc-back {
       position: absolute;
       inset: 0;
       border-radius: 18px;
       display: flex;
       flex-direction: column;
       align-items: center;
       justify-content: center;
       gap: 14px;
       backface-visibility: hidden;
       -webkit-backface-visibility: hidden;
       transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
       padding: 30px;
   }

   .flashcard .fc-front {
       background: linear-gradient(135deg, #667eea, #764ba2);
       color: #fff;
       transform: rotateY(0deg);
   }

   .flashcard .fc-back {
       background: linear-gradient(135deg, #f093fb, #f5576c);
       color: #fff;
       transform: rotateY(180deg);
   }

   .flashcard.flipped .fc-front {
       transform: rotateY(180deg);
   }

   .flashcard.flipped .fc-back {
       transform: rotateY(360deg);
   }

   .fc-emoji {
       font-size: 80px;
       line-height: 1;
   }

   .fc-ar {
       font-size: 48px;
       font-weight: 700;
       font-family: 'Noto Sans Arabic', sans-serif;
       direction: rtl;
   }

   .fc-zh {
       font-size: 36px;
       font-weight: 600;
       font-family: 'Noto Sans SC', sans-serif;
   }

   .fc-hint {
       font-size: 12px;
       opacity: 0.7;
       font-family: 'Noto Sans Arabic', 'Noto Sans SC', sans-serif;
   }

   .fc-controls {
       display: flex;
       gap: 10px;
       justify-content: center;
       flex-wrap: wrap;
   }

   /* ====== Whiteboard ====== */
   .board-card {
       width: 90vw;
       max-width: 900px;
       height: 70vh;
       padding: 16px;
       display: flex;
       flex-direction: column;
   }

   .board-toolbar {
       display: flex;
       gap: 10px;
       align-items: center;
       padding-bottom: 12px;
       border-bottom: 1px solid rgba(102, 126, 234, 0.12);
       margin-bottom: 12px;
       flex-wrap: wrap;
   }

   .board-tool {
       width: 32px;
       height: 32px;
       border-radius: 50%;
       border: 2px solid rgba(0, 0, 0, 0.1);
       cursor: pointer;
       transition: transform 0.2s;
   }

   .board-tool:hover {
       transform: scale(1.15);
   }

   .board-canvas {
       flex: 1;
       background: #fff;
       border-radius: 14px;
       box-shadow: inset 0 0 0 2px rgba(102, 126, 234, 0.08);
       cursor: crosshair;
       touch-action: none;
   }

   [data-theme="dark"] .board-canvas {
       background: #f5f5fa;
   }

   /* ====== Random Student ====== */
   .rs-card {
       width: 380px;
       text-align: center;
       padding: 40px 30px;
   }

   .rs-emoji {
       font-size: 60px;
       margin-bottom: 12px;
   }

   .rs-label {
       color: var(--text-soft);
       font-size: 14px;
       margin-bottom: 20px;
       font-family: 'Noto Sans Arabic', 'Noto Sans SC', sans-serif;
       direction: rtl;
   }

   .rs-number {
       font-size: 120px;
       font-weight: 900;
       background: linear-gradient(135deg, #667eea, #f093fb);
       -webkit-background-clip: text;
       background-clip: text;
       -webkit-text-fill-color: transparent;
       margin: 20px 0;
       line-height: 1;
       font-family: 'Noto Sans Arabic', sans-serif;
       transition: transform 0.2s;
   }

   .rs-number.spinning {
       animation: rsSpin 0.08s linear infinite;
   }

   .rs-number.chosen {
       animation: rsChosen 0.6s ease;
   }

   @keyframes rsSpin {
       0% {
           transform: scale(1);
       }

       50% {
           transform: scale(1.05);
       }

       100% {
           transform: scale(1);
       }
   }

   @keyframes rsChosen {
       0% {
           transform: scale(1);
       }

       30% {
           transform: scale(1.3);
       }

       60% {
           transform: scale(0.95);
       }

       100% {
           transform: scale(1);
       }
   }

   /* ============================================== */
   /*  🔊 PRONUNCIATION COACH - مدرّب النطق          */
   /* ============================================== */
   .pron-coach-toolbar {
       display: flex;
       gap: 6px;
       justify-content: center;
       margin-top: 10px;
       padding-top: 10px;
       border-top: 1px dashed rgba(102, 126, 234, 0.15);
   }

   .pc-btn {
       background: rgba(102, 126, 234, 0.1);
       border: 1px solid rgba(102, 126, 234, 0.2);
       color: var(--primary);
       width: 38px;
       height: 38px;
       border-radius: 10px;
       cursor: pointer;
       font-size: 16px;
       font-weight: 700;
       transition: all 0.2s ease;
       display: flex;
       align-items: center;
       justify-content: center;
       font-family: 'Noto Sans Arabic', sans-serif;
   }

   .pc-btn:hover {
       background: var(--primary);
       color: #fff;
       transform: translateY(-2px);
       box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
   }

   .pc-btn.pc-slow:hover {
       background: var(--warning);
       box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
   }

   .pc-difficulty-dot {
       display: inline-block;
       margin-right: 6px;
       font-size: 14px;
       vertical-align: middle;
       cursor: help;
       animation: pcDotPulse 2s ease-in-out infinite;
   }

   @keyframes pcDotPulse {

       0%,
       100% {
           opacity: 1;
           transform: scale(1);
       }

       50% {
           opacity: 0.6;
           transform: scale(0.85);
       }
   }

   /* ============================================== */
   /*  💡 SMART FEEDBACK - تغذية راجعة ذكية           */
   /* ============================================== */
   .smart-hint {
       margin-top: 10px;
       padding: 14px 18px;
       background: linear-gradient(135deg, rgba(245, 158, 11, 0.08), rgba(240, 147, 251, 0.06));
       border-right: 4px solid var(--warning);
       border-radius: 12px;
       opacity: 0;
       max-height: 0;
       overflow: hidden;
       transition: opacity 0.4s ease, max-height 0.4s ease, padding 0.4s ease;
       padding-top: 0;
       padding-bottom: 0;
       direction: rtl;
   }

   .smart-hint.show {
       opacity: 1;
       max-height: 200px;
       padding-top: 14px;
       padding-bottom: 14px;
   }

   .smart-hint .sh-ar {
       font-family: 'Noto Sans Arabic', sans-serif;
       font-size: 16px;
       color: var(--text);
       line-height: 1.7;
   }

   .smart-hint .sh-ar strong {
       color: var(--success);
       font-weight: 800;
   }

   .smart-hint .sh-zh {
       font-family: 'Noto Sans SC', sans-serif;
       font-size: 13px;
       color: var(--text-soft);
       margin-top: 6px;
       direction: ltr;
   }

   .smart-hint .sh-zh strong {
       color: var(--success);
       font-weight: 700;
   }

   /* ============================================== */
   /*  📱 MOBILE - الأدوات على الموبايل               */
   /* ============================================== */
   @media (max-width: 600px) {
       .teacher-toolbar {
           bottom: 16px;
           left: 16px;
       }

       .tt-toggle {
           width: 50px;
           height: 50px;
           font-size: 22px;
       }

       .tt-panel {
           width: calc(100vw - 32px);
           max-width: 320px;
       }

       .flashcards-card {
           width: 100%;
       }

       .fc-emoji {
           font-size: 60px;
       }

       .fc-ar {
           font-size: 36px;
       }

       .fc-zh {
           font-size: 28px;
       }

       .rs-number {
           font-size: 80px;
       }

       .board-card {
           height: 80vh;
       }

       body.presenter-mode .ar-text {
           font-size: 28px !important;
       }

       body.presenter-mode .vocab-card .ar-text,
       body.presenter-mode .compare-card .ar-text {
           font-size: 32px !important;
       }
   }

   /* ============================================== */
   /*  ♿ Accessibility - تقليل الحركة                */
   /* ============================================== */
   @media (prefers-reduced-motion: reduce) {

       .tt-toggle,
       .tt-btn,
       .pc-btn,
       .flashcard .fc-front,
       .flashcard .fc-back,
       .rs-number {
           transition: none !important;
           animation: none !important;
       }
   }

   /* ============================================== */
   /*  📝 زر تكبير السبورة (تصميم عصري)              */
   /* ============================================== */
   .board-fullscreen-btn {
       position: absolute;
       top: 14px;
       right: 14px;
       width: 38px;
       height: 38px;
       border-radius: 12px;
       border: none;
       background: rgba(255, 255, 255, 0.85);
       backdrop-filter: blur(12px);
       -webkit-backdrop-filter: blur(12px);
       color: var(--text);
       cursor: pointer;
       display: flex;
       align-items: center;
       justify-content: center;
       box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08),
           0 0 0 1px rgba(0, 0, 0, 0.04);
       transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
       z-index: 10;
   }

   .board-fullscreen-btn:hover {
       background: linear-gradient(135deg, #667eea, #764ba2);
       color: #fff;
       transform: scale(1.08);
       box-shadow: 0 6px 18px rgba(102, 126, 234, 0.4);
   }

   .board-fullscreen-btn svg {
       width: 18px;
       height: 18px;
       transition: transform 0.3s ease;
   }

   /* أيقونتا الـ SVG: الاثنتان موجودتان لكن واحدة مخفية */
   .board-fullscreen-btn .fs-collapse {
       display: none;
   }

   .board-fullscreen-btn.active .fs-expand {
       display: none;
   }

   .board-fullscreen-btn.active .fs-collapse {
       display: block;
   }

   .board-fullscreen-btn.active {
       background: linear-gradient(135deg, #667eea, #764ba2);
       color: #fff;
       box-shadow: 0 6px 18px rgba(102, 126, 234, 0.4);
   }

   /* السبورة في وضع التكبير الكامل */
   .tt-modal-card.board-card.fullscreen {
       width: 98vw !important;
       height: 96vh !important;
       max-width: none !important;
       max-height: none !important;
       border-radius: 18px !important;
       transition: width 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
           height 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
           border-radius 0.3s ease;
   }

   .tt-modal-card.board-card {
       transition: width 0.3s ease, height 0.3s ease, border-radius 0.3s ease;
   }

   [data-theme="dark"] .board-fullscreen-btn {
       background: rgba(40, 40, 60, 0.85);
       color: #e8e8f5;
       box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3),
           0 0 0 1px rgba(255, 255, 255, 0.08);
   }